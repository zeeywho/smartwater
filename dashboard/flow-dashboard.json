        "order": 1,
        "width": 6,
        "height": 5,
        "label": "Flow dari waktu ke waktu",
        "chartType": "line",
        "category": "topic",
        "categoryType": "msg",
        "xAxisType": "time",
        "action": "append",
        "class": "",
        "x": 960,
        "y": 220,
        "wires": []
    },
    {
        "id": "text_status",
