[
    {
        "id": "tab_smartwater",
        "type": "tab",
        "label": "SmartWater Dashboard",
        "disabled": false,
        "info": "Dashboard monitoring Smart Water Usage.\nMenerima data MQTT (dan CoAP via jembatan), parse JSON,\ndeteksi kebocoran, lalu tampilkan di gauge/chart/text.",
        "env": []
    },
    {
        "id": "mqtt_in_node",
        "type": "mqtt in",
        "z": "tab_smartwater",
        "name": "MQTT in (smartwater/data)",
        "topic": "smartwater/data",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_cfg",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 120,
        "wires": [
            [
                "json_parse_node"
            ]
        ]
    },
    {
        "id": "json_parse_node",
        "type": "json",
        "z": "tab_smartwater",
        "name": "Parse JSON -> object",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 410,
        "y": 120,
        "wires": [
            [
                "func_leak_detect",
                "debug_node"
            ]
        ]
    },
    {
        "id": "func_leak_detect",
        "type": "function",
        "z": "tab_smartwater",
        "name": "Deteksi Kebocoran",
        "func": "// Ambil field dari payload (semua bertipe number)\nconst flow1 = Number(msg.payload.flow1) || 0;\nconst flow2 = Number(msg.payload.flow2) || 0;\nconst pressure = Number(msg.payload.pressure_adc) || 0;\n\n// THRESHOLD: selisih flow yang dianggap bocor (kalibrasi nanti pakai data normal)\nconst THRESHOLD_SELISIH = 0.5;   // L/min, SESUAIKAN setelah kalibrasi\n\nconst selisih = flow1 - flow2;\n\nlet status = \"NORMAL\";\nlet warna = \"#4caf50\";   // hijau\nif (selisih > THRESHOLD_SELISIH) {\n    status = \"BOCOR\";\n    warna = \"#f44336\";   // merah\n}\n\n// Simpan status & warna di msg untuk node text\nmsg.status = status;\nmsg.warna = warna;\nmsg.selisih = selisih;\n\n// Teruskan msg.payload apa adanya (object) ke gauge/chart\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 120,
        "wires": [
            [
                "gauge_flow1",
                "gauge_flow2",
                "gauge_pressure",
                "chart_flow",
                "text_status"
            ]
        ]
    },
    {
        "id": "debug_node",
        "type": "debug",
        "z": "tab_smartwater",
        "name": "Debug (lihat payload)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 650,
        "y": 60,
        "wires": []
    },
    {
        "id": "gauge_flow1",
        "type": "ui-gauge",
        "z": "tab_smartwater",
        "name": "Gauge Flow1",
        "group": "group_sensor",
        "order": 1,
        "width": 3,
        "height": 3,
        "gtype": "gauge",
        "title": "Flow 1",
        "units": "L/min",
        "icon": "",
        "prefix": "",
        "suffix": "",
        "segments": [],
        "min": 0,
        "max": 30,
        "colorTrack": "#555555",
        "sizeThickness": 16,
        "valueFormat": "{{msg.payload.flow1 | number:2}}",
        "x": 950,
        "y": 40,
        "wires": []
    },
    {
        "id": "gauge_flow2",
