        "group": "group_sensor",
        "order": 3,
        "width": 3,
        "height": 3,
        "gtype": "gauge",
        "title": "Pressure (ADC)",
        "units": "",
        "icon": "",
        "prefix": "",
        "suffix": "",
        "segments": [],
        "min": 0,
        "max": 4095,
        "colorTrack": "#555555",
