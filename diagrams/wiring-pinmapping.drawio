<mxfile host="app.diagrams.net" agent="skripsi-smart-water" version="24.0.0">
  <diagram name="Wiring Pin Mapping" id="wiring-swu-mqtt-coap">
    <mxGraphModel dx="1050" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ESP32 di tengah -->
        <mxCell id="esp32" value="ESP32 DevKit&#10;(logic 3.3V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="470" y="180" width="230" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p_g34" value="GPIO34 (input only, ADC)" style="text;html=1;align=left;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="220" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="p_g27" value="GPIO27" style="text;html=1;align=left;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="252" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="p_g35" value="GPIO35 (input only, ADC)" style="text;html=1;align=left;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="284" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="p_g21" value="GPIO21 (SDA)" style="text;html=1;align=left;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="316" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="p_g22" value="GPIO22 (SCL)" style="text;html=1;align=left;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="348" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="p_33" value="3V3" style="text;html=1;align=left;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="p_gnd" value="GND (common)" style="text;html=1;align=left;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="412" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="p_usb" value="USB ← laptop (power ESP32 saat tes)" style="text;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="444" width="210" height="40" as="geometry" /></mxCell>

        <!-- Flow 1 -->
        <mxCell id="flow1" value="Flow Sensor 1 (YF-S201 type)&#10;VCC=5V, GND, SIGNAL (pulsa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ef1" value="SIGNAL → GPIO34  ⚠ cek level 5V/3.3V" style="endArrow=classic;html=1;strokeColor=#b85450;" edge="1" parent="1" source="flow1" target="p_g34"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Flow 2 -->
        <mxCell id="flow2" value="Flow Sensor 2 (YF-S201 type)&#10;VCC=5V, GND, SIGNAL (pulsa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ef2" value="SIGNAL → GPIO27  ⚠ cek level" style="endArrow=classic;html=1;strokeColor=#b85450;" edge="1" parent="1" source="flow2" target="p_g27"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Voltage divider pressure -->
        <mxCell id="press" value="Pressure Sensor&#10;output 0.5–4.5V, VCC=5V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vd" value="VOLTAGE DIVIDER&#10;Signal —[15kΩ]—•—[10kΩ]— GND&#10;titik • → GPIO35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="epv" style="endArrow=classic;html=1;" edge="1" parent="1" source="press" target="vd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="evd" value="→ GPIO35" style="endArrow=classic;html=1;" edge="1" parent="1" source="vd" target="p_g35"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- INA219 -->
        <mxCell id="ina" value="INA219 (I2C)&#10;VCC dari 3V3 ESP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eina1" value="SDA→GPIO21" style="endArrow=classic;html=1;" edge="1" parent="1" source="ina" target="p_g21"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eina2" value="SCL→GPIO22" style="endArrow=classic;html=1;" edge="1" parent="1" source="ina" target="p_g22"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- POWER RAIL -->
        <mxCell id="pwrLabel" value="JALUR DAYA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="320" height="290" as="geometry" />
        </mxCell>
        <mxCell id="adaptor" value="Adaptor 12V 2A (AC-DC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="830" y="160" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mp1584" value="MP1584 buck → 5V rail&#10;⚠ BELUM diverifikasi (tak ada multimeter).&#10;JANGAN colok ke ESP32/sensor sebelum diukur." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="830" y="220" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rail5" value="5V rail → VCC Flow1, Flow2, Pressure&#10;(setelah MP1584 terverifikasi 5V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="830" y="320" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ep1" style="endArrow=classic;html=1;" edge="1" parent="1" source="adaptor" target="mp1584"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep2" style="endArrow=classic;html=1;" edge="1" parent="1" source="mp1584" target="rail5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Catatan -->
        <mxCell id="note" value="CATATAN KEAMANAN &amp; STATUS: (1) RANCANGAN — belum diverifikasi hardware. (2) GPIO34 &amp; GPIO35 = input-only (tak ada internal pull-up) → pull-up eksternal untuk flow sensor bila perlu. (3) Sinyal flow sensor bisa 5V → cek level sebelum ke GPIO 3.3V. (4) Semua GND harus common. (5) Saat tes awal: ESP32 via USB laptop, MP1584 JANGAN disambung dulu." style="text;html=1;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1060" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
